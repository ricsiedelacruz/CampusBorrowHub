rules_version = '2';

// Campus BorrowHub - Firestore security rules
// Only signed-in students whose VERIFIED email ends in @plmun.edu.ph can use the data.

service cloud.firestore {
  match /databases/{database}/documents {

    function schoolUser() {
      return request.auth != null
        && request.auth.token.email.lower().matches('.*@plmun[.]edu[.]ph');
    }

    function verified() {
      return schoolUser() && request.auth.token.email_verified == true;
    }

    // ---- user profiles ----
    match /users/{uid} {
      allow read: if verified();
      allow create, update: if schoolUser() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- item listings ----
    match /items/{itemId} {
      allow read: if verified();

      allow create: if verified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'AVAILABLE'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100;

      // the owner may only change availability status and condition history
      allow update: if verified()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history']);

      allow delete: if verified() && resource.data.ownerId == request.auth.uid;
    }

    // ---- borrow requests (only the borrower and lender can see them) ----
    match /requests/{requestId} {
      allow read: if verified()
        && (resource.data.borrowerId == request.auth.uid
            || resource.data.lenderId == request.auth.uid);

      allow create: if verified()
        && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.lenderId != request.auth.uid
        && request.resource.data.status == 'PENDING';

      allow update: if verified()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'dueAt', 'returnCondition', 'returnNote', 'returnedAt'])
        && (resource.data.lenderId == request.auth.uid
            || (resource.data.borrowerId == request.auth.uid
                && resource.data.status == 'PENDING'
                && request.resource.data.status == 'CANCELLED'));

      allow delete: if false;
    }

    // ---- chat messages (only the two people in the chat) ----
    match /messages/{messageId} {
      allow read: if verified() && request.auth.uid in resource.data.participants;

      allow create: if verified()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      allow update, delete: if false;
    }

    // ---- ratings & feedback (one per person per transaction, cannot be edited) ----
    match /reviews/{reviewId} {
      allow read: if verified();

      allow create: if verified()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;

      allow update, delete: if false;
    }

    // ---- in-app notifications ----
    match /notices/{noticeId} {
      allow read: if verified() && resource.data.userId == request.auth.uid;

      allow create: if verified()
        && request.resource.data.keys().hasOnly(['userId', 'text', 'at', 'read']);

      // the owner can only mark a notification as read
      allow update: if verified()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if verified() && resource.data.userId == request.auth.uid;
    }

    // ---- reports (write-only for students; admins read them in the Firebase console) ----
    match /reports/{reportId} {
      allow read: if false;
      allow create: if verified() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
